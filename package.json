{
  "name": "ace-id-sdk",
  "version": "0.2.4",
  "description": "Official JavaScript/TypeScript SDK for Ace ID (OpenID Connect).",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/oidc-mock.d.ts",
      "import": "./dist/testing/oidc-mock.js",
      "require": "./dist/testing/oidc-mock.cjs"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js",
      "require": "./dist/diagnostics.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.vanilla.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run check:bundle && npm run verify:package",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run build && npm run check:bundle && npm run verify:package"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-test-renderer": "^19.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "author": "aceyash-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tab-gl/ace-id-sdk.git"
  },
  "homepage": "https://github.com/tab-gl/ace-id-sdk#readme",
  "bugs": {
    "url": "https://github.com/tab-gl/ace-id-sdk/issues"
  },
  "keywords": [
    "ace-id",
    "openid-connect",
    "oidc",
    "oauth2",
    "authentication",
    "identity",
    "pkce",
    "typescript"
  ]
}
